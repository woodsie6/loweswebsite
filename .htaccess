# ═══ Canonical Host ═══
# Send HTTP → HTTPS and www → non-www (apex) so there is one canonical address.
# Only the apex and www hosts match; other subdomains remain untouched.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(?:www\.)?lowesbuildingservices\.co\.uk$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.lowesbuildingservices\.co\.uk$ [NC]
  RewriteRule ^ https://lowesbuildingservices.co.uk%{REQUEST_URI} [R=301,L]
</IfModule>

# ═══ Security Headers ═══
<IfModule mod_headers.c>
  # 'unsafe-inline' on style-src permits the inline animation custom properties.
  # The script hash permits only the one-line pre-paint bootstrap in index.html.
  Header set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self' 'sha256-WZRJfWvsnNCPcxzZwvyhovnZGqhZaC+8gPGPRbx6wTk='; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests;"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HTML always revalidates. Stable asset names receive bounded caching so a
  # deployment cannot strand visitors on an old stylesheet or script.
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(?:ico|jpe?g|png|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

# Prefer Brotli when the host provides it, otherwise fall back to Deflate.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/ld+json image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json image/svg+xml
  </IfModule>
</IfModule>
